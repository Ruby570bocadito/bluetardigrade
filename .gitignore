# Go
bin/
/engine
/devsensor
*.exe
*.test
*.out
vendor/

# Rust
sensor/target/
# sensor/Cargo.lock is deliberately NOT ignored: binary crates commit
# the lockfile for reproducible builds (present in the repo since the
# 2026-09-29 17h32 round; refresh with `cargo update` as needed).

# Node (web console)
web/**/node_modules/
web/console/.next/
web/console/out/
web/console/next-env.d.ts
web/console/*.tsbuildinfo

# Local environment files (never commit credentials)
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local installer artifacts
run/
tools/

# Operator-local suppressions (the armed copy of suppressions.example.yaml;
# may name real hosts and change windows - never commit it)
suppressions.yaml

# Local evidence
captures/
*.dmp

# Agent tooling residue (not part of the product)
.agents/
.claude/
