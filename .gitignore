# Go
bin/
/engine
/devsensor
*.exe
*.test
*.out
vendor/
.cache/
# Coverage and profiling artifacts from `go test -coverprofile` /
# -cpuprofile / -memprofile: never part of the source tree.
coverage.txt
coverage.html
*.cover
*.prof
*.pprof

# Release build output (make dist; the release workflow rebuilds it
# fresh on the runner — never committed)
dist/

# Rust
sensor/target/
sensor/target-*/
# sensor/Cargo.lock is deliberately NOT ignored: binary crates commit
# the lockfile for reproducible builds (present in the repo since the
# 2026-09-29 17h32 round; refresh with `cargo update` as needed).

# Python bytecode (dev-tests receivers run under python3 stdlib)
__pycache__/

# Node (web console)
web/**/node_modules/
web/console/.next/
web/console/out/
web/console/next-env.d.ts
web/console/*.tsbuildinfo

# Local environment files (never commit credentials)
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local installer artifacts
run/
tools/

# Operator-local suppressions (the armed copy of suppressions.example.yaml;
# may name real hosts and change windows - never commit it)
suppressions.yaml

# Local evidence
captures/
/forensics/
*.dmp

# Agent tooling residue (not part of the product; the round records
# were archived out of the public tree in the bluetardigrade rename
# round). agent/ must not come back as a product-tree path.
.agents/
agent/

# Engine runtime state (alert triage, r6): operator-owned, never committed
alert-lifecycle.json
alert-lifecycle.json.tmp

# Active-response runtime state: the audit JSONL records real hosts,
# processes and operator identities per attempt, and the operators
# allowlist names the team — same operator-owned class as the triage
# file above (defaults of -respond-audit / -respond-operators).
respond-audit.jsonl
respond-operators.yaml

# Optional SQLite persistence (-store): events/alerts beyond the
# in-memory rings, operator-local data.
sf-store.db
sf-store.db-wal
sf-store.db-shm


# Operator reports contain incident evidence.
/reports/
