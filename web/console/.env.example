# Copy to .env.local when you need to change the defaults.
# Server only: never put credentials in NEXT_PUBLIC_* variables.
ENGINE_API_URL=http://127.0.0.1:7778
SF_API_TOKEN=

# Optional AI analyst hub; telemetry works without it.
NEXT_PUBLIC_CONSOLE_URL=http://127.0.0.1:3003

# The console binds 127.0.0.1 (package.json). To serve it to other
# machines, allow the public hostname AND set a console credential:
# every request then needs HTTP Basic auth (any user, this token as the
# password). Without CONSOLE_ACCESS_TOKEN, extra hosts are refused unless
# CONSOLE_ALLOW_UNAUTHENTICATED=1 declares a front end that authenticates.
# Terminate TLS in front of the console when it leaves the machine.
CONSOLE_ALLOWED_HOSTS=
CONSOLE_ACCESS_TOKEN=
CONSOLE_ALLOW_UNAUTHENTICATED=

# Same value as the hub's HUB_ACCESS_TOKEN when the hub demands one
# (required when it binds beyond loopback). Served to the browser only
# through the authenticated /api/hub-token route.
HUB_ACCESS_TOKEN=
