# Copy to .env.local when you need to change the defaults.
# Server only: never put credentials in NEXT_PUBLIC_* variables.
ENGINE_API_URL=http://127.0.0.1:7778
SF_API_TOKEN=

# Optional AI analyst hub; telemetry works without it.
NEXT_PUBLIC_CONSOLE_URL=http://127.0.0.1:3003

# Extra public hostnames must be explicitly allowed by the proxy.
# This is an access boundary, not a login system.
CONSOLE_ALLOWED_HOSTS=
